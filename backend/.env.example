# MedAssist Backend — Environment Configuration Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control. Only .env.example is committed.

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
APP_NAME=MedAssist API
ENVIRONMENT=development
VERSION=0.2.0

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ──────────────────────────────────────────────
# CORS — comma-separated list of allowed origins
# ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────────
# Supabase — Phase 2 (Database + Storage)
# Get these from: Supabase Dashboard → Project Settings → API
# ──────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key-here

# Server-side secret key (NEVER expose through API responses or logs)
# Get from: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SECRET_KEY=your-service-role-secret-key-here

# Supabase JWT Secret for token verification
# Get from: Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here


# ──────────────────────────────────────────────
# Supabase Storage
# ──────────────────────────────────────────────
SUPABASE_STORAGE_BUCKET=medical-documents

# ──────────────────────────────────────────────
# AI Services (Phase 3 — Gemini)
# ──────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ──────────────────────────────────────────────
# Document AI (Phase 3 — Google Document AI / OCR)
# ──────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
DOCUMENT_AI_PROCESSOR_ID=your-processor-id
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# ──────────────────────────────────────────────
# RAG / Vector Search (Phase 3)
# ──────────────────────────────────────────────
# PGVECTOR_CONNECTION_STRING=postgresql+asyncpg://...
